{
    "name": "angular-prebuilt",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "dev": "npm-run-all --parallel spa",
        "start": "npm-run-all --parallel spa-prod",
        "spa": "ng serve",
        "spa-prod": "ng serve --configuration production",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test"
    },
    "private": true,
    "engines": {
        "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
    },
    "dependencies": {
        "@angular/common": "^22.3.0",
        "@angular/compiler": "^22.3.0",
        "@angular/core": "^22.3.0",
        "@angular/platform-browser": "^22.3.0",
        "@angular/router": "^22.3.0",
        "rxjs": "^7.8.2",
        "supertokens-web-js": "latest",
        "tslib": "^2.3.0",
        "zone.js": "~0.16.3"
    },
    "devDependencies": {
        "@angular/build": "^22.3.0",
        "@angular/cli": "^22.3.0",
        "@angular/compiler-cli": "^22.3.0",
        "@ngx-env/builder": "^22.1.0",
        "@types/jasmine": "~5.1.0",
        "jasmine-core": "~5.2.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "typescript": "~6.0.3"
    }
}
