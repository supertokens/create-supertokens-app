{
    "name": "svelte-supertokens",
    "version": "0.0.1",
    "private": true,
    "engines": {
        "node": "^22.17.0 || >=24"
    },
    "scripts": {
        "start": "vite dev",
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "eslint .",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@sveltejs/adapter-auto": "^9.0.0",
        "@sveltejs/kit": "^3.4.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.2",
        "@types/eslint": "^9.6.1",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.24.1",
        "globals": "^17.14.0",
        "prettier": "^3.10.1",
        "prettier-plugin-svelte": "^4.2.0",
        "svelte": "^5.59.2",
        "svelte-check": "^4.7.8",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.74.0",
        "vite": "^8.4.0"
    },
    "type": "module",
    "dependencies": {
        "jsonwebtoken": "^9.0.2",
        "jwks-rsa": "^3.1.0",
        "supertokens-node": "latest",
        "supertokens-web-js": "latest"
