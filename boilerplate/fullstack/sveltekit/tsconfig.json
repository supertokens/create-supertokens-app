{
    "extends": "$app/tsconfig",
    "include": ["src/**/*.svelte", "src/**/*.ts", "vite.config.ts"],
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true
    }
}
